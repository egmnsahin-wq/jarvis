# Copy this file to "local.properties" in the project root (same folder as this file)
# and fill in your own keys. local.properties is NOT committed/shared and is read
# directly by the Gradle build (see app/build.gradle.kts).

sdk.dir=/path/to/your/Android/sdk

# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
